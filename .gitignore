
# Ignore everything by default
*

# Keep root files
!.gitignore
!README.md

# Allow QNX project path
!qnx/
!qnx/recoveryehack/

# Ignore QNX files by default
qnx/recoveryehack/*

# Allow only the C source and Makefile
!qnx/recoveryehack/src/
qnx/recoveryehack/src/*
!qnx/recoveryehack/src/recoveryehack.c
!qnx/recoveryehack/Makefile
